{
  "version": 2,
  "builds": [
    {
      "src": "backend/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.9",
        "maxLambdaSize": "15mb",
        "buildCommand": "bash build.sh"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "backend/wsgi.py" }
  ],
  "functions": {
    "backend/wsgi.py": {
      "maxDuration": 15
    }
  }
}