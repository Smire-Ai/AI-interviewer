# Environment Variables for AI Interviewer

# OpenAI API Key (required for enhanced AI features)
# Without this, the system will use fallback question generation and evaluation
OPENAI_API_KEY=your_openai_api_key_here

# Database URL
# For SQLite (default): sqlite:///./ai_interviewer.db
# For PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./ai_interviewer.db

# Application Settings
DEBUG=False
HOST=0.0.0.0
PORT=8000